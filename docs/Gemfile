# Local build of the docs site only. GitHub Actions does not read this file;
# it uses the github-pages gem through actions/jekyll-build-pages, which is
# why the same gem is pinned here so local and CI output match.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# Ruby 3 no longer bundles these; Jekyll 3 (what github-pages uses) needs them.
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"

# Windows and JRuby time-zone data.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw, :mswin]
